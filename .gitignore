# Byte-compiled
__pycache__/
*.py[cod]

# uv-managed virtualenv
.venv/

# Test/type/lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# snowball output rendered next to the sources (make docs-build writes to dist/docs/)
docs/*.pdf
docs/*.epub
# snowball check renders mermaid diagrams into the working directory
.asciidoctor/
diag-mermaid-*.png

# Environment files (Makefile's create-env/config-dev/config-test write these)
.env
.env.*

# macOS
.DS_Store

# graphify - graph.json/GRAPH_REPORT.md/manifest.json are versioned (merge
# driver + post-commit hook keep them in sync); ignore only local/regenerable bits
# graphify-out/.graphify_python
# graphify-out/.graphify_root
# graphify-out/cache/
# graphify-out/cost.json
# graphify-out/graph.html
graphify-out/
